# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube al repo (está en .gitignore).

# --- Base de datos (obligatoria) ---
# Postgres, por el uso de JSONB en Producto.especificaciones. SQLite no sirve.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# --- Autenticación JWT (obligatoria en producción) ---
# Si no se define, el código cae a una clave de respaldo insegura — definila
# siempre en Railway. Generar una nueva con: openssl rand -hex 32
SECRET_KEY=

# --- Cloudinary: fotos de producto (routers/producto.py) ---
# Sin esto, subir/eliminar foto de un producto falla; el resto de la API
# sigue funcionando con normalidad.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend: correo de confirmación de pedido (routers/pedidoWeb.py) ---
# Sin esto, el pedido se crea igual; simplemente no se envía el correo
# (el error se traga y se registra en consola, nunca rompe la compra).
RESEND_API_KEY=

# --- Wompi: verificación de firma del webhook (routers/pedidoWeb.py) ---
# Secreto de eventos de Wompi (no es la llave pública ni la privada).
# Se encuentra en el dashboard de Wompi > Desarrolladores > Secretos.
# Sin esto, CUALQUIER firma se valida como inválida y los pagos nunca
# se confirman — es obligatoria antes de activar Wompi en producción.
WOMPI_EVENTS_SECRET=
